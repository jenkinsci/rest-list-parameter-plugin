<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="${%config.name}">
    <f:entry title="${%config.cacheSize}" field="cacheSize">
      <f:number default="50" checkMethod="post"/>
    </f:entry>
    <f:entry title="${%config.cacheTime}" field="cacheTime">
      <f:number default="0" checkMethod="post"/>
    </f:entry>
    <f:entry title="${%config.fetchTimeout}" field="fetchTimeout">
      <f:number default="60" checkMethod="post"/>
    </f:entry>
    <f:validateButton title="${%config.clearValueCache}" progress="${%config.clearingValueCache}"
                      method="clearValueCache"/>
  </f:section>
</j:jelly>