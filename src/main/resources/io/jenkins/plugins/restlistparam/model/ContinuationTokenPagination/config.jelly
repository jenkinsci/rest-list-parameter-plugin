<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%pagination.tokenExpression}" field="tokenExpression">
    <f:textbox checkMethod="post" />
  </f:entry>

  <f:entry title="${%pagination.queryParameter}" field="queryParameter">
    <f:textbox checkMethod="post" />
  </f:entry>

  <f:entry title="${%pagination.maxPages}" field="maxPages">
    <f:number default="${descriptor.defaultMaxPages}" checkMethod="post" />
  </f:entry>
</j:jelly>
