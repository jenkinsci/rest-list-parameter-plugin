<!-- this is the page fragment displayed when trying to run the job with a RLP -->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core"
         xmlns:st="jelly:stapler"
         xmlns:l="/lib/layout"
         xmlns:f="/lib/form">

  <st:adjunct includes="io.jenkins.plugins.jquery3"/>
  <st:adjunct includes="io.jenkins.plugins.select2"/>
  <st:adjunct includes="io.jenkins.plugins.restlistparam.RestListParameterDefinition.loader"/>
  <j:set var="id" value="${h.generateId()}"/>
  <!-- the entries are not fetched while rendering; loader.js requests them through this bound object -->
  <st:bind var="rlpLoader_${id}" value="${it.createLoader()}"/>

  <link rel="stylesheet" type="text/css" href="${resURL}/plugin/rest-list-parameter/css/select2-jenkins.css"/>

  <j:set var="escapeEntryTitleAndDescription" value="false"/>
  <f:entry title="${h.escape(it.name)}" description="${it.formattedDescription}">
    <!-- this div is required because of ParametersDefinitionProperty.java#117 -->
    <div name="parameter" description="${it.description}"
         data-rlp-id="${id}" data-rlp-loader="rlpLoader_${id}" data-rlp-state="loading"
         data-rlp-mode="${it.enableValidation ? 'select' : 'custom'}"
         data-rlp-timeout="${it.descriptor.fetchTimeout}">
      <input type="hidden" name="name" value="${it.name}"/>

      <!-- Both modes render the same dropdown. With validation disabled the user may also type a value that is
           not among the entries (loader.js offers it as the custom value); the default is shown as a custom
           option until the entries arrive, as the free-text input showed it before. -->
      <select id="${id}-select" data-select2-id="${id}-select" data-allow-empty-value="${it.allowEmptyValue}"
              data-custom-label="${it.customValueLabel}" class="setting-input" name="value">
        <j:if test="${it.allowEmptyValue}">
          <option value="" data-rlp-empty="true" selected="${empty it.defaultValue ? 'selected' : null}">&#8212;</option>
        </j:if>
        <j:if test="${!it.enableValidation and !empty it.defaultValue}">
          <option value="${it.defaultValue}" data-rlp-custom="true" selected="selected">${it.defaultValue}</option>
        </j:if>
      </select>

      <st:include page="loaderControls.jelly" class="io.jenkins.plugins.restlistparam.RestListParameterDefinition"/>

      <j:if test="${divBasedFormLayout}">
        <st:include page="loaderError.jelly" class="io.jenkins.plugins.restlistparam.RestListParameterDefinition"/>
      </j:if>
    </div>
  </f:entry>

  <j:if test="${!divBasedFormLayout}">
    <tr>
      <td colspan="2"></td>
      <td>
        <st:include page="loaderError.jelly" class="io.jenkins.plugins.restlistparam.RestListParameterDefinition"/>
      </td>
    </tr>
  </j:if>

</j:jelly>
